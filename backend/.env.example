# OpsPilot AI Configuration
PROJECT_NAME="OpsPilot AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY="opspilot-super-secure-dev-secret-key-change-in-production-12345678"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL="sqlite:///./opspilot.db"

# LLM Provider Configuration
# Options: "gemini", "openai", "mock"
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
LLM_MODEL_NAME="gemini-1.5-flash"

# RAG & Embeddings
CHROMA_PERSIST_DIRECTORY="./chroma_storage"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Operations Rules
MAX_AGENT_STEPS=8
AGENT_TIMEOUT_SECONDS=30
REQUIRE_APPROVAL_REFUND_THRESHOLD=0.0

